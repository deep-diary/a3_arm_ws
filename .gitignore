# colcon / ROS 2
build/
install/
log/
.colcon_install_layout
COLCON_IGNORE

# Python
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# IDE / editor
.vscode/
.idea/
*.swp
*~
.DS_Store

# ROS bags / runtime
*.bag
*.bag.active
*.db3
*.db3-shm
*.db3-wal

# LeRobot recorded datasets (parquet + mp4, regenerated by record_sim.py)
/data/

# 相机采集产物（F182 camera_capture_ui：图片/视频素材，不入库）
/capture/

# Local / secrets
.env
.env.*
*.pem
id_rsa
id_ed25519

# 本机 sudo 密码（工作区规则，仅本机有效，勿入库）
.trae/rules/local-sudo.md

# micro-ROS host build tree (~hundreds of MB, nested clones + install)
# Copy via tar to RK3588 instead of committing; see docs/lessons_learned/LL-001
src/third_party/micro_ros_host/
src/third_party/moveit_debs/

# joynet: external DS4-over-TCP tool (nested clone, 86M incl. .venv); F63
src/third_party/joynet/

# Wave A sim verification scratch logs (regenerated by scripts/verify_wave_a_sim.sh)
docs/dev/_wave_a_sim_logs/

# candump raw capture (test artifacts, regenerated on demand)
candump-*.log

# 回放轨迹报告（scripts/make_report.py 生成产物，不入库）
/report/

# 运行时轨迹产物（归仓库 trajectories/ 目录，但不 git 跟踪；Q4/F163）
/trajectories/*.yaml
/trajectories/waypoints/
/trajectories/streams/
!/trajectories/**/.gitkeep

# 预烘焙轨迹缓存（F16x：melodion_bake.py 生成 <name>.yaml.baked.yaml，可删可重烘焙）
*.baked.yaml

# 分享用导出包（html-report-presentation 插件生成，内容与 docs/architecture/ 逐字节重复）
.trae-html-share-packages/

# 舞蹈槽运行时产物（F197：连续录制体积大且带 backup/；确需入库时 git add -f）
/trajectories/dance/

# 示教槽位时间戳备份（F195/F198：滚动备份，属运行噪声）
/trajectories/**/teach_wp_*.yaml
