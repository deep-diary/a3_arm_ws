  <!-- 连杆（6 轴形态的末端连杆，F174）
       - 相对轴 6 法兰输出（l5_l6_urdf_asm）偏移 (0, 0, linkage_offset_z)，默认 -0.14 m
         （14 cm 打印件；初步估算，待实测）
       - 暂无 STP：用圆柱占位（radius/length/mass 见上方 xacro arg）。连杆本体在
         linkage_link 是「法兰 → 末端（TCP）」这一段：linkage_link 原点落在末端，
         所以圆柱形心在 +linkage_length/2 处，向上延伸到法兰。
       - 质量 0.02 kg 为打印件占位值（很轻），参与重力前馈；换 STP 后一并修正。 -->
  <link name="linkage_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.07"/>
      <mass value="0.02"/>
      <inertia ixx="3.274666666666667e-05" ixy="0" ixz="0" iyy="3.274666666666667e-05" iyz="0" izz="1.6e-07"/>
    </inertial>
    <visual>
