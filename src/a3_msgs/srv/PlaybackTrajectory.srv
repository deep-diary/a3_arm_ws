# 读取本地轨迹文件并回放
string name
# F131/F162/F163/F164: 轨迹槽类型 — ""=连续轨迹(默认，向后兼容) / "waypoint"=路点任务 / "stream"=轨迹流(逐段+段末停+每段mode/speed/sleep/via) / "cp"=连续笛卡尔路径(lin折线+circ圆弧，一条过点样条)
string type
# F131: 路点段策略 — "ptp"=关节空间自动规划(默认) / "lin"=TCP 笛卡尔走直线
string strategy
# F198: 路点规划方式（type="waypoint" 时生效；留空=沿用旧 strategy ptp/lin）
# 允许: ptp|ptp_blend|lin_exact|lin_blend|jnt_g64_quintic|jnt_g64_trapezoid
#       |jnt_spline_bell|jnt_spline_approx（circ 需辅助点，不支持）
string mode
# F197/F198: 循环播放（type=dance 的连续槽 / type=waypoint 且给了 mode 时生效；
# 旧 type=waypoint 的 strategy 链路仍忽略 loop）
bool loop
---
bool success
string message
