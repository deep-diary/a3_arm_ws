<?xml version="1.0"?>
<!-- Two-finger parallel gripper visualization driven by L7 revolute (motor encoder).
     L7=0 rad: fully open; L7=pi/2: fully closed. Fingers mimic L7 via prismatic joints.
     gripper_link (L7 child) has no mesh — avoids whole-jaw spin in RViz. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="gripper_mount_z" value="-0.074"/>
  <xacro:property name="gripper_finger_z" value="-0.0755"/>
  <xacro:property name="gripper_finger_open_half_gap" value="0.022"/>
  <xacro:property name="gripper_finger_travel" value="0.022"/>
  <xacro:property name="gripper_mimic_k" value="${gripper_finger_travel / 1.5708}"/>

  <xacro:macro name="el_a3_gripper" params="parent_link wrist_effort">
    <!-- Motor 7: revolute driver (no visible geometry on child link) -->
    <joint name="L7_joint" type="revolute">
      <origin xyz="0 0 ${gripper_mount_z}" rpy="0 0 0"/>
      <parent link="${parent_link}"/>
      <child link="gripper_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="${wrist_effort}" velocity="50" lower="0" upper="1.5708"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <link name="gripper_link">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <!-- Fixed palm between fingers (does not rotate with L7) -->
    <link name="gripper_palm_link">
      <inertial>
        <mass value="0.02"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${gripper_finger_z}" rpy="3.14159 0 0"/>
        <geometry>
          <box size="0.028 0.012 0.018"/>
        </geometry>
        <material name="dark_brown"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${gripper_finger_z}" rpy="3.14159 0 0"/>
        <geometry>
          <box size="0.028 0.012 0.018"/>
        </geometry>
      </collision>
    </link>

    <joint name="gripper_palm_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent_link}"/>
      <child link="gripper_palm_link"/>
    </joint>

    <!-- Left finger: +Y side, slides toward center as L7 increases -->
    <link name="left_finger_link">
      <inertial>
        <mass value="0.015"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${gripper_finger_z}" rpy="3.14159 0 0"/>
        <geometry>
          <box size="0.010 0.014 0.038"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${gripper_finger_z}" rpy="3.14159 0 0"/>
        <geometry>
          <box size="0.010 0.014 0.038"/>
        </geometry>
      </collision>
    </link>

    <joint name="left_finger_joint" type="prismatic">
      <origin xyz="0 ${gripper_finger_open_half_gap} 0" rpy="0 0 0"/>
      <parent link="${parent_link}"/>
      <child link="left_finger_link"/>
      <axis xyz="0 -1 0"/>
      <limit effort="20" velocity="0.05" lower="0" upper="${gripper_finger_travel}"/>
      <mimic joint="L7_joint" multiplier="${gripper_mimic_k}" offset="0"/>
    </joint>

    <!-- Right finger: -Y side, mirror of left -->
    <link name="right_finger_link">
      <inertial>
        <mass value="0.015"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${gripper_finger_z}" rpy="3.14159 0 0"/>
        <geometry>
          <box size="0.010 0.014 0.038"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${gripper_finger_z}" rpy="3.14159 0 0"/>
        <geometry>
          <box size="0.010 0.014 0.038"/>
        </geometry>
      </collision>
    </link>

    <joint name="right_finger_joint" type="prismatic">
      <origin xyz="0 ${-gripper_finger_open_half_gap} 0" rpy="0 0 0"/>
      <parent link="${parent_link}"/>
      <child link="right_finger_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" velocity="0.05" lower="0" upper="${gripper_finger_travel}"/>
      <mimic joint="L7_joint" multiplier="${gripper_mimic_k}" offset="0"/>
    </joint>
  </xacro:macro>

</robot>
