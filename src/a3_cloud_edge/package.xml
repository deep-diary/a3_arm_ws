<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a3_cloud_edge</name>
  <version>0.1.0</version>
  <description>CloudEdge Linux stack: micro-ROS Agent launch, mock client, trajectory test</description>
  <maintainer email="dev@example.com">a3_arm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>a3_microros_mock</exec_depend>
  <exec_depend>a3_description</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
