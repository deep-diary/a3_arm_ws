# 单电机 MIT 直驱：单发一帧或 ROS 侧定时保持（需求 F32）
uint8  motor_id         # 目标电机 CAN_ID（1..127；禁止 0 广播，安全考虑）
float32 position_rad    # 目标角度（±12.57，超出自动 clamp）
float32 velocity_rad_s  # 目标速度（±50，默认 0）
float32 kp              # 位置增益（0..500）
float32 kd              # 速度阻尼（0..5）
float32 torque_ff_nm    # 力矩前馈（±6）
float32 hold_duration_s # <=0 单发一帧；>0 定时保持（上限 max_hold_duration_s 默认 30 s）
float32 hold_hz         # 保持发送频率（<=0 默认 50 Hz；上限 min(200, max_tx_rate_per_motor_hz)）
---
bool success
string message          # 例如 "one-shot sent motor=1" / "hold started motor=1 (2.0 s @ 20.0 Hz)" / 拒绝原因
