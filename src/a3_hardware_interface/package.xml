<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a3_hardware_interface</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface for the A3 arm: SocketCAN + RobStride MIT motor
    protocol running directly inside controller_manager (real-hardware plugin).
  </description>
  <maintainer email="cat@todo.todo">Blue</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>a3_can_bridge</depend>
  <depend>a3_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>pinocchio</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>
  <!-- F49 inertia_params.yaml is resolved at runtime via ament_index; no
       package depend here: a3_description already exec-depends on this
       package, declaring the reverse would be a circular dependency. -->


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
